---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const psychologyPosts = await getCollection('psychology');
  const neurosciencePosts = await getCollection('neuroscience');

  return [...psychologyPosts, ...neurosciencePosts].map(post => ({
    params: { slug: `${post.collection}/${post.id}` },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Generate a description from the title or hardcoded summary
const description = `了解关于 ${post.data.title} 的更多信息。作者：胡安·莫伊塞斯·德·拉·塞尔纳博士，心理学与神经科学专家。`;
---

<Layout title={post.data.title} description={description}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-12">
      <div class="text-blue-600 font-semibold mb-2 uppercase tracking-wider">{post.data.category}</div>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4">{post.data.title}</h1>
      <div class="flex items-center text-gray-500">
        <span class="mr-4">作者: {post.data.author}</span>
        <span>发布日期: {post.data.pubDate.toLocaleDateString('zh-CN')}</span>
      </div>
    </header>

    <div class="prose prose-blue prose-lg max-w-none">
      <Content />
    </div>

    <footer class="mt-16 pt-8 border-t border-gray-200">
      <div class="bg-blue-50 p-6 rounded-lg">
        <h3 class="text-lg font-bold text-blue-900 mb-2">关于作者</h3>
        <p class="text-blue-800">
          <strong>胡安·莫伊塞斯·德·拉·塞尔纳 (Juan Moisés de la Serna)</strong>：
          心理学博士，神经科学与行为生物学硕士，大学教授，科学传播者。
        </p>
      </div>
    </footer>
  </article>
</Layout>

<style is:global>
  .prose h2 { @apply text-2xl font-bold mt-8 mb-4 border-b pb-2; }
  .prose h3 { @apply text-xl font-semibold mt-6 mb-3; }
  .prose p { @apply mb-4 leading-relaxed; }
  .prose ul { @apply list-disc ml-6 mb-4; }
  .prose ol { @apply list-decimal ml-6 mb-4; }
  .prose blockquote { @apply border-l-4 border-blue-500 pl-4 italic text-gray-700 my-6; }
</style>
